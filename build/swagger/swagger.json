{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "A vector database REST API for storing and querying vector embeddings.",
        "title": "GoVec API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8000",
    "basePath": "/",
    "paths": {
        "/api/v1/vectors": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Insert or update a vector",
                "parameters": [
                    {
                        "description": "Vector payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreateVectorRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handlers.InsertResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/vectors/search": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Search for similar vectors",
                "parameters": [
                    {
                        "description": "Search payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.SearchRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/index.SearchResult"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/vectors/{id}": {
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Delete a vector by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Vector ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handlers.DeleteResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/api.HealthResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "handlers.CreateVectorRequest": {
            "type": "object",
            "required": [
                "id",
                "vector"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "example": "vec-001"
                },
                "metadata": {
                    "type": "object"
                },
                "sparse_vector": {
                    "type": "object"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "handlers.DeleteResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "vec-001"
                },
                "status": {
                    "type": "string",
                    "example": "deleted"
                }
            }
        },
        "handlers.InsertResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "inserted"
                }
            }
        },
        "handlers.SearchRequest": {
            "type": "object",
            "required": [
                "vector"
            ],
            "properties": {
                "filter": {
                    "type": "object"
                },
                "k": {
                    "type": "integer",
                    "example": 10
                },
                "sparse_vector": {
                    "type": "object"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "index.SearchResult": {
            "type": "object",
            "properties": {
                "ID": {
                    "type": "string",
                    "example": "vec-001"
                },
                "Meta": {
                    "type": "object"
                },
                "Score": {
                    "type": "number",
                    "example": 0.97
                }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        }
    }
}